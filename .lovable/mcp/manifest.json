{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "zoka-web-wallet-mcp",
      "version": "0.1.0",
      "title": "Zoka Web Wallet"
    },
    "tools": [
      {
        "name": "get_network_info",
        "title": "Get Zoka network info",
        "description": "Return public network metadata (network name, chain id, node version, address prefix) for a Zoka RPC node. Uses mock RPC data — no wallet secrets are ever accessed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "enum": [
                "mock-mainnet",
                "mock-testnet",
                "mock-local"
              ],
              "default": "mock-testnet",
              "description": "Which authorized RPC node to query."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_block_height",
        "title": "Get current block height",
        "description": "Return the current tip block height for a Zoka RPC node. Public chain data only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "enum": [
                "mock-mainnet",
                "mock-testnet",
                "mock-local"
              ],
              "default": "mock-testnet",
              "description": "Which authorized RPC node to query."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_fee_estimate",
        "title": "Get transaction fee estimate",
        "description": "Return low/normal/high fee estimates in atomic units for a Zoka RPC node. Public data — no wallet interaction.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "node_id": {
              "type": "string",
              "enum": [
                "mock-mainnet",
                "mock-testnet",
                "mock-local"
              ],
              "default": "mock-testnet",
              "description": "Which authorized RPC node to query."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_rpc_nodes",
        "title": "List authorized RPC nodes",
        "description": "List the authorized Zoka RPC nodes this wallet knows about, with id, label, url, network and official flag.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "validate_zoka_address",
        "title": "Validate a Zoka address format",
        "description": "Lightweight, non-cryptographic sanity check on a Zoka address string: verifies the expected 'zoka1' prefix and length bounds. This does NOT verify the address on-chain and is not a substitute for the official validator.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1,
              "description": "The Zoka address to check."
            }
          },
          "required": [
            "address"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
